# ========================================
# AuraTrade 環境變數範例
# ========================================
# 複製此檔案為 .env 並填入實際值
# 不要將 .env 提交到 Git!
# ========================================

# ========================================
# 基本設定
# ========================================
ENVIRONMENT=development
# 可選值: development, staging, production

# ========================================
# 資料庫設定
# ========================================
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/auratrade
# 格式: postgresql://[用戶名]:[密碼]@[主機]:[端口]/[資料庫名]

# ========================================
# Redis 設定（可選）
# ========================================
REDIS_URL=redis://localhost:6379/0
# 用於快取與背景任務佇列

# ========================================
# JWT 安全設定
# ========================================
JWT_SECRET_KEY=your-super-secret-key-at-least-32-characters-long-please-change-this
# 重要! 生產環境必須使用強隨機金鑰
# 可使用 openssl rand -hex 32 生成

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# CORS 設定
# ========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# 生產環境範例: https://yourdomain.com,https://www.yourdomain.com

# ========================================
# Google Gemini API
# ========================================
GEMINI_API_KEY=your_gemini_api_key_here
# 取得方式: https://ai.google.dev/

# ========================================
# LINE Messaging API
# ========================================
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
# 取得方式: https://developers.line.biz/console/

# ========================================
# 股價資料 API
# ========================================
STOCK_API_KEY=your_stock_api_key_here
STOCK_API_URL=https://api.stock-service.com
# 依使用的股價資料服務而定

# ========================================
# Email 設定（用於註冊驗證）
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password
SMTP_FROM_EMAIL=noreply@auratrade.com
SMTP_FROM_NAME=AuraTrade

# ========================================
# 日誌設定
# ========================================
LOG_LEVEL=INFO
# 可選值: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_PER_MINUTE=60
# API 每分鐘請求限制

# ========================================
# 前端設定（VITE_前綴）
# ========================================
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws
VITE_ENVIRONMENT=development

# ========================================
# Sentry 錯誤追蹤（可選）
# ========================================
# SENTRY_DSN=https://your_sentry_dsn_here

# ========================================
# Google Analytics（生產環境可選）
# ========================================
# VITE_GA_TRACKING_ID=UA-XXXXX-X

# ========================================
# 加密金鑰（用於敏感資料加密）
# ========================================
ENCRYPTION_KEY=your_encryption_key_32_bytes_base64_encoded
# 可使用 python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 生成
