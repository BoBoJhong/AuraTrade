# Application Settings
APP_NAME=AuraTrade
APP_VERSION=1.0.0
DEBUG=True

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auratrade
DB_ECHO=False

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# External APIs (填入實際金鑰)
GEMINI_API_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
YAHOO_FINANCE_API_KEY=

# Rate Limiting
AI_DAILY_LIMIT=20
NOTIFICATION_DAILY_LIMIT=50

# Business Rules
MAX_WATCHLIST_SIZE=50
STOCK_UPDATE_INTERVAL_SECONDS=2
